{
  "name": "campfire",
  "version": "0.1.0",
  "private": true,
  "description": "Campfire · a Discord RPG bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc && copyfiles -u 1 \"src/images/**/*\" dist",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@twemoji/parser": "^17.0.2",
    "@vanta-dev/node": "^0.1.5",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "imagescript": "3.20.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "typescript": "^5.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0"
  }
}
